{
  "schema": "backendlab.report/v1",
  "tool": {
    "name": "backendlab",
    "version": "test"
  },
  "command": "compare",
  "inputs": [
    {
      "kind": "suite",
      "name": "examples/invoice.yaml",
      "sha256": "0123456789abcdef0123456789abcdef"
    }
  ],
  "targets": [
    "baseline",
    "candidate"
  ],
  "status": "failed",
  "summary": {
    "cases": 3,
    "cases_by_status": {
      "cancelled": 0,
      "error": 1,
      "failed": 1,
      "inconclusive": 0,
      "passed": 1,
      "skipped": 0
    },
    "findings": {
      "total": 3,
      "failing": 2,
      "by_kind": {
        "assertion_failure": 0,
        "difference": 1,
        "inconclusive": 1,
        "observation": 0,
        "transport_error": 1,
        "unsupported": 0
      },
      "by_severity": {
        "error": 2,
        "info": 0,
        "warning": 1
      }
    }
  },
  "cases": [
    {
      "id": "get-invoice",
      "status": "failed",
      "observations": [
        {
          "target": "baseline",
          "status_code": 200,
          "duration_ms": 12.5
        },
        {
          "target": "candidate",
          "status_code": 200,
          "duration_ms": 1520
        }
      ]
    },
    {
      "id": "list|invoices",
      "status": "error",
      "observations": [
        {
          "target": "baseline",
          "error": "connection refused"
        }
      ]
    },
    {
      "id": "health",
      "status": "passed"
    }
  ],
  "findings": [
    {
      "module": "compare",
      "code": "compare.unordered_key_missing",
      "kind": "inconclusive",
      "severity": "warning",
      "case_id": "get-invoice",
      "location": "/items",
      "message": "element without key `sku` | [link](http://x)"
    },
    {
      "module": "compare",
      "code": "compare.value_changed",
      "kind": "difference",
      "severity": "error",
      "case_id": "get-invoice",
      "location": "/total",
      "message": "value changed",
      "expected": "100.00",
      "observed": "100.05"
    },
    {
      "module": "replay",
      "code": "replay.connection_failed",
      "kind": "transport_error",
      "severity": "error",
      "case_id": "list|invoices",
      "message": "dial failed\u001b[31m",
      "details": {
        "target": "baseline"
      }
    }
  ],
  "limitations": [
    "Single-run timings are observations, not statistically established regressions."
  ]
}
