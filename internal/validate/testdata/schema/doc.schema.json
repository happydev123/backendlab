{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "total"],
  "properties": {
    "id": {"type": "string"},
    "total": {"type": ["string", "number"]},
    "subtotal": {"type": ["string", "number"]},
    "tax": {"type": ["string", "number"]},
    "card_number": {"type": "string", "pattern": "^[0-9]{16}$"}
  }
}
