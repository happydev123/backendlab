# Copy to .env for docker compose. Never commit the real file.

# PostgreSQL password used by the compose database service.
POSTGRES_PASSWORD=change-me

# Connection string read by serve, worker and migrate (the name is set by
# database.url_env in the server config).
BACKENDLAB_DATABASE_URL=postgres://backendlab:change-me@postgres:5432/backendlab?sslmode=disable

# bcrypt hash of the operator password. Generate it with:
#   printf '%s\n' 'your long passphrase' | backendlab hash-password
# In this file, write every $ in the hash as $$ so compose does not treat it
# as a variable.
BACKENDLAB_ADMIN_PASSWORD_HASH=

# Example credential for a target header; it must also be listed under
# credentials.allowed_env in the server config.
STAGING_API_KEY=
